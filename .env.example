# ==============================================================================
# SkillMap AI Agent Environment Configuration
# Copy this file to '.env' and populate with your personal API credentials.
# NEVER commit the active '.env' file to version control.
# ==============================================================================

# Google Gemini API Key (Required for agent model inference)
# Get your API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Tavily API Key (Required for live industry skill demand and career trend search)
# Get your API key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# RapidAPI Key for JSearch API (Required for live real-time job listings)
# Subscribe and get your key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_jsearch_key_here

# Optional Configurations
# Model identifier for Google Gemini (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database path for persistent LangGraph conversational checkpointing
SQLITE_DB_PATH=data/checkpoints.db
